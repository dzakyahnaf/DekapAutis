# Salin berkas ini menjadi .env, lalu isi nilainya. .env TIDAK PERNAH di-commit.
#
# Aturan mutlak nomor 4 di CLAUDE.md: kunci API model bahasa hanya hidup di
# Supabase Edge Function secrets. Tidak ada satu pun kunci model di berkas ini,
# karena berkas ini dibaca sisi klien dan apa pun yang ada di sini akan ikut
# masuk ke dalam APK.

# --- Supabase, sisi klien -----------------------------------------------------
# Anon key memang boleh dilihat publik: ia hanya berguna bersama RLS, dan RLS
# di proyek ini default deny. Tetap tidak di-commit supaya URL proyek tidak
# tersebar sebelum waktunya.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Stack lokal --------------------------------------------------------------
# Nilai bawaan `supabase start`. Bukan rahasia, sama di setiap mesin.
# Port 553xx, bukan 543xx: proyek Supabase lain di mesin ini memakai 543xx.
SUPABASE_URL_LOKAL=http://127.0.0.1:55321
SUPABASE_DB_URL_LOKAL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- JANGAN taruh di sini -----------------------------------------------------
# GEMINI_API_KEY dan GROQ_API_KEY adalah rahasia sisi peladen. Setel dengan:
#   supabase secrets set GEMINI_API_KEY=... GROQ_API_KEY=...
# Untuk pengembangan lokal Edge Function, pakai supabase/.env.local
# (juga tidak di-commit).
